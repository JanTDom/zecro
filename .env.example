# Vite build-time setting. For a Vercel frontend, point this at the deployed
# FastAPI service (for example https://api.zecro.pl), or leave it as /api when
# a same-origin reverse proxy is configured.
VITE_API_URL=/api

# Optional backend adapters. Never commit real values.
VLM_ENDPOINT=
OPENAI_API_KEY=

# Production CORS allow-list. Comma-separated origins, e.g.
# https://zecro.pl,https://www.zecro.pl
ZECRO_CORS_ORIGINS=http://localhost:3000

# Gemini API — real value lives only in .env.local
GEMINI_API_KEY=
GEMINI_MODEL_TEXT_PRO=gemini-3.1-pro-preview
GEMINI_MODEL_TEXT_FAST=gemini-3.8-flash
GEMINI_MODEL_IMAGE=gemini-3-pro-image
GEMINI_MODEL_EMBED=gemini-embedding-2
ZECRO_SECRETS_KEY=   # klucz Fernet do szyfrowania sekretów z panelu ustawień

# Gemini provider (loaded independently from database env opt-in)
GEMINI_API_KEY=
GEMINI_MODEL_TEXT_PRO=gemini-3.1-pro-preview
GEMINI_MODEL_TEXT_FAST=gemini-3.8-flash
GEMINI_MODEL_IMAGE=gemini-3-pro-image
GEMINI_MODEL_EMBED=gemini-embedding-2
GEMINI_TIMEOUT_S=90
GEMINI_MAX_RETRIES=3
AI_MONTHLY_BUDGET_USD=
ZECRO_SECRETS_KEY=
ZECRO_ADMIN_TOKEN=
